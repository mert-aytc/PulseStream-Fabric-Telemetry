table Comparison
	lineageTag: f5960b30-18bb-4513-be7b-172cc12bb92a

	calculationGroup

		calculationItem Actual = SELECTEDMEASURE()

			formatStringDefinition = SELECTEDMEASUREFORMATSTRING()

		calculationItem 'Δ vs all riders' = SELECTEDMEASURE() - CALCULATE(SELECTEDMEASURE(), ALL(dim_rider))

			formatStringDefinition = SELECTEDMEASUREFORMATSTRING()

		calculationItem '% vs all riders' =
				VAR _all = CALCULATE(SELECTEDMEASURE(), ALL(dim_rider))
				RETURN DIVIDE(SELECTEDMEASURE() - _all, _all)

			formatStringDefinition = "+0.0%;-0.0%;0.0%"

